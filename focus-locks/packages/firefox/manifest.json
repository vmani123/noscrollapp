{
  "manifest_version": 3,
  "name": "Intentional Browsing",
  "version": "0.3.2",
  "description": "Perry: block Threads and feeds on YouTube, Reddit, and Bilibili; gate LinkedIn notifications.",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://youtu.be/*",
        "*://*.reddit.com/*",
        "*://redd.it/*",
        "*://*.threads.com/*",
        "*://*.threads.net/*",
        "*://*.bilibili.com/*",
        "*://b23.tv/*"
      ],
      "js": [
        "policy.js",
        "content.js"
      ],
      "css": [
        "focus.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "linkedin-policy.js",
        "linkedin.js"
      ],
      "css": [
        "linkedin.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "linkedin-policy.js",
      "linkedin-background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "intentional-browsing@local.invalid",
      "strict_min_version": "109.0"
    }
  }
}
