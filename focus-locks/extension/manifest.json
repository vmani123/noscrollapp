{
  "manifest_version": 3,
  "name": "Intentional Browsing",
  "version": "0.3.2",
  "description": "Perry: block Threads and feeds on YouTube, Reddit, and Bilibili; gate LinkedIn notifications.",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://youtu.be/*",
        "*://*.reddit.com/*",
        "*://redd.it/*",
        "*://*.threads.com/*",
        "*://*.threads.net/*",
        "*://*.bilibili.com/*",
        "*://b23.tv/*"
      ],
      "js": [
        "policy.js",
        "content.js"
      ],
      "css": [
        "focus.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "linkedin-policy.js",
        "linkedin.js"
      ],
      "css": [
        "linkedin.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://youtu.be/*",
    "*://*.reddit.com/*",
    "*://redd.it/*",
    "*://*.linkedin.com/*",
    "*://*.threads.com/*",
    "*://*.threads.net/*",
    "*://*.bilibili.com/*",
    "*://b23.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "spanning",
  "declarative_net_request": {
    "rule_resources": [{"id": "threads", "enabled": true, "path": "threads-rules.json"}]
  }
}
